with gr.Blocks() as interface:
    gr.Markdown("# Elective Recommendation System")
    gr.Markdown("Enter your interests and completed courses to get personalized elective recommendations.")

    with gr.Row():
        interests_input = gr.Textbox(label="Interests (comma-separated)", placeholder="e.g., data science, machine learning")
        completed_courses_input = gr.Textbox(label="Completed Courses (comma-separated IDs)", placeholder="e.g., 1")
        submit_button = gr.Button("Get Recommendations")

    recommendations_output = gr.Textbox(label="Recommended Courses")

    with gr.Row():
        view_courses_button = gr.Button("View All Courses")
        all_courses_output = gr.Textbox(label="All Available Courses", interactive=False)

    submit_button.click(
        fn=recommend,
        inputs=[interests_input, completed_courses_input],
        outputs=[recommendations_output]
    )

    view_courses_button.click(
        fn=view_all_courses,
        inputs=[],
        outputs=[all_courses_output]
    )

# Launch the interface
