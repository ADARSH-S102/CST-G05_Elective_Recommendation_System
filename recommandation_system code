def recommend_courses(interests, completed_courses):
    recommendations = []
    interests_set = set(interests)  # Convert interests to a set for faster lookup
    completed_courses_set = set(completed_courses)  # Convert completed courses to a set for faster lookup

    for course in courses:
        if str(course["id"]) not in completed_courses_set:
            # Check if any tag in the course matches the user's interests
            if any(tag.lower() in interests_set for tag in course["tags"]):
                recommendations.append(course["name"])

    return recommendations

def recommend_with_openai(interests, completed_courses):
    try:
        # Request OpenAI to generate course recommendations using gpt-3.5-turbo model
        prompt = f"Given the following interests: {', '.join(interests)} and completed courses: {', '.join(completed_courses)}, suggest some elective courses based on the information provided."

        response = openai.ChatCompletion.create(
            model="gpt-3.5-turbo",  # Using gpt-3.5-turbo model
            messages=[
                {"role": "system", "content": "You are a helpful assistant that suggests courses based on the user's interests and completed courses."},
                {"role": "user", "content": prompt}
            ],
            max_tokens=150,
            temperature=0.7,
        )

        recommendations = response.choices[0].message['content'].strip()
        return recommendations

    except Exception as e:
        return f"Error generating recommendations: {str(e)}"

def recommend(interests, completed_courses):
    # Convert input strings to lists
    interests_list = [interest.strip().lower() for interest in interests.split(",")]
    completed_courses_list = [course.strip() for course in completed_courses.split(",")]

    # First, try to generate recommendations from available courses based on tags
    recommendations = recommend_courses(interests_list, completed_courses_list)

    # If no courses match, use OpenAI to generate recommendations
    if not recommendations:
        recommendations = recommend_with_openai(interests_list, completed_courses_list)

    # Return recommendations as a comma-separated string
    return ", ".join(recommendations) if isinstance(recommendations, list) else recommendations

def view_all_courses():
    # Display all available courses
    return "\n".join([f"{course['id']}: {course['name']} - Curriculum: {', '.join(course['tags'])}" for course in courses])

